ARG NGINX_IMAGE
FROM ${NGINX_IMAGE}
ARG SOURCE_SHA
ARG CI_RUN_ID
LABEL org.opencontainers.image.source="https://github.com/beidaomitu233/xinghui-admin-vue3" \
      org.opencontainers.image.revision="${SOURCE_SHA}" io.xinghui.ci-run="${CI_RUN_ID}"
COPY nginx.conf /etc/nginx/nginx.conf
COPY web/ /usr/share/nginx/html/
COPY docs/ /usr/share/nginx/html/docs/
COPY release.json /usr/share/nginx/html/__release.json
USER 101:101
EXPOSE 18180
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:18180/ || exit 1
