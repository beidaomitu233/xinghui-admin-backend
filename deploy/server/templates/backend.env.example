# SERVER PRIVATE FILE /etc/xinghui/backend.env, root:root 0600. Never commit its real copy.
# Compose >=2.30 raw env_file: literal values, NO surrounding quotes or shell commands.
DB_URL=jdbc:mysql://127.0.0.1:3306/REPLACE_REVIEWED_SCHEMA?useSSL=true&serverTimezone=Asia/Shanghai
DB_USERNAME=REPLACE_WITH_APPLICATION_USER
DB_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
SPRING_DATA_REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=REPLACE_WITH_RESERVED_ISOLATED_REDIS_DB
REDIS_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
JWT_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_OR_LONGER_SIGNING_SECRET
CONFIG_MASTER_KEY=REPLACE_WITH_EXISTING_32_BYTE_BASE64_MASTER_KEY_WHEN_MIGRATING_DATA
MAIL_ENABLED=false
DRUID_ENABLED=false
OSS_ENABLED=false
# For enabled MinIO, actual application.yml uses OSS_* (not the older QA MINIO_* names):
# OSS_ENABLED=true
# OSS_ENDPOINT=https://storage.example.invalid
# OSS_ACCESS_KEY=REPLACE_PRIVATELY
# OSS_SECRET_KEY=REPLACE_PRIVATELY
# OSS_BUCKET=xinghui-admin
# OSS_PREFIX=
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai
TZ=Asia/Shanghai
# Optional outbound proxy must be reviewed separately. Never disable certificate validation.
# OPENROUTER_HTTP_PROXY=http://approved-proxy.internal.example.invalid:3128
